Include ~/.colima/ssh_config

IgnoreUnknown UseKeychain

# Default = personal (Rishikhesh). Falls back to id_ed25519 on a fresh machine.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Work (rixhy-cyd). CypherD-IO remotes are rewritten to this via ~/.gitconfig insteadOf.
Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
